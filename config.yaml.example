# LMU AI 크루치프 설정 예시.
# 이 파일을 config.yaml로 복사한 뒤 수정하세요. 생략한 항목은 기본값이 적용됩니다.

app:
  poll_hz: 5                 # 스코어링 폴링 주기 (Hz)
  console_status_sec: 1.0    # 콘솔 상태 라인 출력 간격 (초)
  log_level: INFO
  save_race_json: true       # 레이스 종료 시 랩 히스토리를 data/에 JSON 저장
  speech_log: true           # 발화 로그 data/speech_log.jsonl (반복감/타이밍 검토)
  require_realtime: true     # 모니터/메뉴에선 발화 중단 (오작동 시 false)
  data_dir: data

voice:
  enabled: true
  volume: 0.9
  language: ko
  driver_name: 드라이버       # 멘트에서 부르는 호칭
  # 크루치프 페르소나 (LLM 시스템 프롬프트에 들어감)
  persona: >
    당신은 20년 경력의 내구레이스 크루치프다. 침착하고 간결하며,
    드라이버를 신뢰하는 톤. 숫자를 나열하지 않고 판단을 말한다.
    무전 특유의 짧은 문장을 쓴다.

tts:
  engine: edge               # edge | elevenlabs (11labs가 훨씬 자연스러움, 유료)
  edge_voice: ko-KR-InJoonNeural   # ko-KR-HyunsuMultilingualNeural(더 자연스러운 남성)
                                   # ko-KR-SunHiNeural(여성) 등으로 교체 가능
  edge_rate: "+10%"          # 말 속도
  elevenlabs_api_key: ""     # engine: elevenlabs 사용 시
  elevenlabs_voice_id: ""
  cache_dir: audio_cache
  radio_fx: true             # 무전기 효과 — TTS 기계음을 팀라디오 질감으로 가림
  radio_noise: 0.004         # 무전 배경 노이즈 (0 = 없음, 0.01 = 지직거림 강함)

# HUD 대체용 정기 무전 — HUD를 끄고 달릴 때 켠다 (기본은 꺼짐, 침묵 철학)
reports:
  laptime_every_lap: true    # 매 랩 랩타임 콜 ("이번 랩 2분 1.8초. 베스트야.")
  status_every_laps: 3       # N랩마다 순위/갭/연료/타이어 리포트 (0=끔)

# LMU 내장 REST API 보조 소스 — 공유 메모리에 없는 정보(가상 에너지/날씨
# 예보/피트 전략) 보충용. 게임이 없거나 포트가 다르면 자동 비활성.
# 실제 엔드포인트 확정은 게임 실행 중 tools/probe_rest.py 실행 후 진행.
rest:
  enabled: true
  base_url: http://localhost:6397
  poll_sec: 3.0

llm:
  enabled: true
  model: claude-haiku-4-5   # 짧은 멘트 생성엔 haiku 계열로 충분
  api_key: ""                # 비우면 환경변수 ANTHROPIC_API_KEY 사용
  max_tokens: 200
  timeout_sec: 10
  budget_per_hour: 15        # LLM 호출 예산 (2시간 레이스 기준 30회 이내)

# 분석기 임계값 — 발화 억제의 핵심. 높일수록 조용해짐.
thresholds:
  fuel_warn_laps: 3.0          # 남은 연료 N랩 이하 → 경고
  fuel_critical_laps: 1.5      # 긴급 경고
  pace_delta_sec: 0.7          # 평소 대비 랩타임 편차 (초)
  gap_change_sec_per_lap: 0.4  # 앞뒤 갭 변화율 (초/랩)
  traffic_eta_sec: 10.0        # 접근 예고: 도달 예상 N초 이내
  traffic_race_only: false     # true면 연습/퀄리(고스트 차 많음)에선 트래픽 콜 끔
  sector_yellow_calls: true    # 섹터 옐로 콜이 이상하게 반복되면 false
  proximity_m: 50.0            # 근접(NEARBY) 진입 거리 (m)
  alongside_m: 12.0            # 나란히(ALONGSIDE) 판정 거리 (m)
  tyre_temp_imbalance: 12.0    # 좌우/전후 타이어 온도 불균형 (°C)
  tyre_wear_warn: 0.35         # 남은 수명 비율 경고선
  damage_impact_mag: 500.0     # 충격 크기 임계값
  water_temp_warn: 105.0       # 수온 경고 (°C)
  oil_temp_warn: 115.0         # 유온 경고 (°C)
  brake_temp_warn: 700.0       # 브레이크 평균 온도 경고 (°C)
  fuel_save_delta: 0.1         # 목표 대비 랩당 오버 소모 코칭 기준 (L)
  rival_pace_diff: 0.3         # 라이벌 페이스 인텔 기준 (초/랩)
  wetness_crossover: 0.20      # 슬릭 한계 웻니스

# 같은 유형 이벤트의 재발화 최소 간격 (초)
cooldowns:
  fuel_warning: 240
  traffic: 20                # 접근 예고
  traffic_close: 8           # 근접/나란히 긴급 콜
  traffic_update: 15         # 지나감/떨어짐 후속
  traffic_multi: 25          # 다중 차량 종합
  bridge: 20                 # 긴급 콜 뒤 LLM 후속
  pace_comment: 120
  gap_comment: 90
  tyre_warning: 180
  damage: 60
  damage_report: 20          # 충격 후 자동 점검 결과
  wheel_damage: 30           # 휠 탈락
  penalty: 30
  lap_analysis: 300
  stint_briefing: 120
  lap_feedback: 150          # 트레이닝: 섹터 델타 피드백
  track_trend: 600
  race_control: 15           # FCY/레이스 스타트
  fcy_pit_open: 45           # FCY 피트 오픈 (전용 버킷)
  green_flag: 30             # 리스타트
  sector_yellow: 45
  blue_flag: 45              # 블루 플래그 (랩핑 트레인 통과 중 반복 억제)
  race_milestone: 60
  position_change: 45
  rival_pit: 90
  rival_pace: 240
  pit_limiter: 15
  engine_warning: 240
  fuel_save: 180
  default: 60
